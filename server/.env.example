PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/lead_management_db
# Generate locally: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d
BUSINESS_TIMEZONE=Africa/Cairo
# Render: set mongodb to keep uploads in Atlas across restarts/deploys.
UPLOAD_STORAGE=local
# Number of trusted reverse proxies; Render uses 1. Keep 0 for local development.
TRUST_PROXY_HOPS=0
